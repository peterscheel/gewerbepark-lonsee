{
  // Name muss exakt dem Worker-Namen in Cloudflare entsprechen
  "name": "gewerbepark-lonsee",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Kontaktformular: Empfänger und Absender. Der API-Key (RESEND_API_KEY) kommt als Secret ins Dashboard.
  "vars": {
    "CONTACT_TO": "gerrit.korner@zaunteam.de",
    "CONTACT_FROM": "Gewerbepark Lonsee <kontakt@gewerbepark-lonsee.de>"
  },
  "keep_vars": true
}
